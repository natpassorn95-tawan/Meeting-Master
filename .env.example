# Copy to .env and fill in. .env is gitignored.
# LINE Official Account — Messaging API channel access token.
LINE_CHANNEL_ACCESS_TOKEN=

# Channel secret — required to verify inbound webhook signatures.
LINE_CHANNEL_SECRET=

# Optional: a single LINE userId to target with "push" mode (saves quota vs broadcast).
LINE_TEST_USER_ID=

# Public origin participant deep-links point at. Must be https for real LINE
# delivery; use http://<LAN-IP>:5273 for same-WiFi phone demos.
PUBLIC_BASE_URL=http://localhost:5273

# Background scheduler auto-sends recurring notices when a send window arrives.
# Set to 0 to disable real auto-sending (windows are still tracked + logged).
SCHEDULER_AUTOSEND=1

# LIFF — opens the buttons INSIDE LINE (layered over the chat) and identifies
# the user automatically. Create a LIFF app in the LINE console (endpoint URL =
# this app's public https URL), then set the SAME id in both vars:
#   LIFF_ID      → server, so notice/registration buttons emit liff.line.me URLs
#   VITE_LIFF_ID → client, so the web app inits the LIFF SDK
# Leave blank to fall back to plain https links (opens in LINE's in-app browser).
LIFF_ID=
VITE_LIFF_ID=

# Admin console passcode (lets the admin unlock the console on a phone).
# Defaults to "aiai" if unset. Client-side gate — not strong security.
VITE_ADMIN_CODE=

# OPAL central identity service (optional). When BOTH are set, a completed
# registration is mirrored to the identity service (LINE userId ↔ email) so
# other OPAL apps can resolve this person. Leave blank to disable — registration
# works either way; failures never block it (they queue + retry).
#   IDENTITY_SERVICE_URL → base URL, e.g. http://localhost:8901
#   IDENTITY_SERVICE_KEY → the Bearer token from `npm run seed` in identity-service
IDENTITY_SERVICE_URL=
IDENTITY_SERVICE_KEY=

# Aiai Board tasks endpoint (optional). When BOTH are set together with the
# IDENTITY_SERVICE_* pair above, the rich-menu「任務」button resolves the tapper's
# LINE userId → email → their open Aiai Board work items and replies with a Flex
# card list. Leave blank to disable (the button then shows a soft "coming soon").
#   AIAI_BOARD_TASKS_URL → base URL of the tasks Cloud Function, e.g.
#     https://asia-east1-<project>.cloudfunctions.net/tasksApi
#   AIAI_BOARD_API_KEY   → must equal TASKS_API_KEY set in aiai-boards/functions/.env
AIAI_BOARD_TASKS_URL=
AIAI_BOARD_API_KEY=
